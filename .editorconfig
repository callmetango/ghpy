root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 90
spelling_language = en-US
tab_width = 4
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space
max_line_length = off
trim_trailing_whitespace = false

[*.ya?ml]
indent_size = 2
indent_style = space
max_line_length = off

